<section class="home-feed" aria-label="最近文章">
  <% var field_sort = theme.posts_overview.sort_updated ? 'updated' : 'date' %>
  <% if (theme.posts_overview.show_all_posts) { %>
    <% var show_posts = page.posts.sort(field_sort, 'desc') %>
  <% } else { %>
    <% var show_posts = site.posts.sort(field_sort, 'desc').limit(theme.posts_overview.post_count || 10) %>
  <% } %>
  <% show_posts.each(function(post){ %>
    <% var rawSummary = post.description || post.excerpt || post.content || '' %>
    <% var summary = strip_html(rawSummary).replace(/\s+/g, ' ').trim() %>
    <% if (summary.length > 190) { summary = summary.slice(0, 190).replace(/[，。；、,.!?！？\s]*$/, '') + '…' } %>
    <a class="home-card-link" href="<%- url_for(post.path) %>">
      <article class="home-card h-entry">
        <h2 class="home-card-title p-name"><%= post.title %></h2>
        <div class="home-card-summary p-summary">
          <time class="home-card-date" datetime="<%= date_xml(post[field_sort]) %>">【<%= date(post[field_sort], config.date_format) %>】</time><%= summary %>
        </div>
      </article>
    </a>
  <% }) %>
</section>

<div class="home-archive-link">
  <a href="<%- url_for(theme.nav.articles) %>">查看全部文章 <span aria-hidden="true">→</span></a>
</div>
