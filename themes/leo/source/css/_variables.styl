// Fonts
// WebKit maps ui-serif to New York. Named faces cover browsers and platforms
// that do not expose that system generic.
$font-family-body = "Leo Songti SC", ui-serif, "New York", "Iowan Old Style", Charter, Georgia, "Times New Roman", "Noto Serif", "Liberation Serif", "Songti SC", STSong, "Noto Serif CJK SC", "Source Han Serif SC", SimSun, serif
$font-family-emphasis = "Leo Kaiti SC", "Leo Songti SC", ui-serif, "New York", "Iowan Old Style", Charter, Georgia, "Times New Roman", "Noto Serif", "Liberation Serif", "Kaiti SC", STKaiti, KaiTi, "KaiTi_GB2312", "Songti SC", STSong, serif
$font-family-ui = system-ui, -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif
$font-family-mono = "Menlo", "Meslo LG", monospace
$font-size = 14px
$line-height = 1.725
$page-width = 0rem + (hexo-config("page_width") || 39)
// Logo
$logo-width = 0px + (hexo-config("logo.width") || 0)
$logo-height = 0px + (hexo-config("logo.height") || 0)
$logo-grayout = hexo-config("logo.grayout") || false
// Colors
$colors = hexo-config("colorscheme") || "dark"
