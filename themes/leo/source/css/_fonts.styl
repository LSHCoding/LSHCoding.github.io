// Local-only CJK aliases keep mixed-language text on the requested Chinese
// face without replacing Latin glyphs. No font files are downloaded.
@font-face
  font-family: "Leo Songti SC"
  font-style: normal
  font-weight: 400
  src: local("STSongti-SC-Regular"), local("Songti SC Regular"), local("STSong"), local("Songti SC"), local("Noto Serif CJK SC"), local("Source Han Serif SC"), local("SimSun")
  unicode-range: U+2E80-2FFF, U+3000-303F, U+3100-31EF, U+3400-4DBF, U+4E00-9FFF, U+F900-FAFF, U+FE10-FE1F, U+FE30-FE4F, U+FF00-FFEF, U+20000-2FA1F, U+30000-323AF

@font-face
  font-family: "Leo Songti SC"
  font-style: normal
  font-weight: 700
  src: local("STSongti-SC-Bold"), local("Songti SC Bold"), local("Noto Serif CJK SC Bold"), local("Source Han Serif SC Bold")
  unicode-range: U+2E80-2FFF, U+3000-303F, U+3100-31EF, U+3400-4DBF, U+4E00-9FFF, U+F900-FAFF, U+FE10-FE1F, U+FE30-FE4F, U+FF00-FFEF, U+20000-2FA1F, U+30000-323AF

// Kaiti is upright in Chinese typography. Declaring it as the italic face of
// this local alias keeps the selected Latin serif's real italics and upright
// Kai forms for Chinese emphasis.
@font-face
  font-family: "Leo Kaiti SC"
  font-style: italic
  font-weight: 400
  src: local("STKaitiSC-Regular"), local("STKaiti-SC-Regular"), local("Kaiti SC Regular"), local("STKaiti"), local("KaiTi"), local("KaiTi_GB2312")
  unicode-range: U+2E80-2FFF, U+3000-303F, U+3100-31EF, U+3400-4DBF, U+4E00-9FFF, U+F900-FAFF, U+FE10-FE1F, U+FE30-FE4F, U+FF00-FFEF, U+20000-2FA1F, U+30000-323AF

@font-face
  font-family: "Leo Kaiti SC"
  font-style: italic
  font-weight: 700
  src: local("STKaitiSC-Bold"), local("STKaiti-SC-Bold"), local("Kaiti SC Bold")
  unicode-range: U+2E80-2FFF, U+3000-303F, U+3100-31EF, U+3400-4DBF, U+4E00-9FFF, U+F900-FAFF, U+FE10-FE1F, U+FE30-FE4F, U+FF00-FFEF, U+20000-2FA1F, U+30000-323AF

@font-face
  font-style: normal
  font-family: "Meslo LG"
  src: local("Meslo LG S"), url("../lib/meslo-LG/MesloLGS-Regular.ttf") format("truetype")
